ENVIRONMENT=local
LOG_LEVEL=INFO

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_GROUP_ID=observability-diagnosis-agent
KAFKA_DIAGNOSIS_REQUESTED_TOPIC=diagnosis.requested.v1
KAFKA_DIAGNOSIS_PROGRESS_TOPIC=diagnosis.progress.v1
KAFKA_DIAGNOSIS_COMPLETED_TOPIC=diagnosis.completed.v1
KAFKA_DIAGNOSIS_FAILED_TOPIC=diagnosis.failed.v1
KAFKA_DIAGNOSIS_DLQ_TOPIC=diagnosis.requested.v1.dlq

JAVA_GRPC_TARGET=localhost:9090
JAVA_GRPC_TIMEOUT_SECONDS=10
INCIDENT_LOG_LIMIT=100

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=2

IDEMPOTENCY_DB_PATH=.data/agent.db
IDEMPOTENCY_STALE_AFTER_SECONDS=300

HEALTH_HOST=0.0.0.0
HEALTH_PORT=8090
