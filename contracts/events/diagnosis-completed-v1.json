{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnosis-completed-v1",
  "type": "object",
  "required": ["eventId", "taskId", "incidentId", "version", "rootCause", "confidence", "evidence", "recommendations", "toolCalls", "completedAt", "error"],
  "properties": {
    "eventId": {"type": "string"}, "taskId": {"type": "string"}, "incidentId": {"type": "string"},
    "version": {"type": "integer", "minimum": 1}, "rootCause": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "toolCalls": {"type": "array", "items": {"type": "string"}},
    "completedAt": {"type": "string", "format": "date-time"}, "error": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
